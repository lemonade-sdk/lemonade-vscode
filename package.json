{
	"name": "lemonade-sdk",
	"publisher": "lemonade-sdk",
	"displayName": "Lemonade for GitHub Copilot",
	"description": "An extension that integrates Lemonade local LLM server into GitHub Copilot Chat",
	"icon": "assets/logo.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/lemonade-sdk/lemonade-vscode"
	},
	"version": "0.0.10",
	"engines": {
		"vscode": "^1.109.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"galleryBanner": {
		"color": "#100f11",
		"theme": "dark"
	},
	"badges": [
		{
		"url": "https://img.shields.io/github/stars/lemonade-sdk/lemonade?style=social",
		"description": "Star lemonade on Github",
		"href": "https://github.com/lemonade-sdk/lemonade"
		}
	],
	"homepage": "https://github.com/lemonade-sdk/lemonade",
	"bugs": {
		"url": "https://github.com/lemonade-sdk/lemonade/issues"
	},
	"license": "MIT",
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "lemonade",
				"displayName": "Lemonade",
				"icon": "assets/provider-icon.png",
				"configuration": {
					"type": "object",
					"properties": {
						"url": {
							"type": "string",
							"title": "Server URL",
							"description": "Lemonade server URL, e.g. http://localhost:13305/api/v1",
							"default": "http://localhost:13305/api/v1"
						},
						"apiKey": {
							"type": "string",
							"title": "API Key",
							"description": "Optional API key. Leave empty to use the default.",
							"secret": true
						}
					},
					"required": ["url"]
				}
			}
		],
		"configuration": {
			"title": "Lemonade",
			"properties": {
				"lemonade.reasoningEffort": {
					"type": "string",
					"enum": ["", "none", "low", "medium", "high"],
					"default": "",
					"markdownDescription": "Reasoning effort sent to the server as `reasoning_effort`. Leave empty to use the server default. Overridden by the model picker when the `chatProvider` API is available."
				},
				"lemonade.reasoningEfforts": {
					"type": "object",
					"default": {
						"*": ["none", "low", "medium", "high"]
					},
					"additionalProperties": {
						"type": "array",
						"items": { "type": "string" }
					},
					"markdownDescription": "Reasoning effort levels shown in the model picker. Keys are case-insensitive substrings of the model id (e.g. `\"gpt-oss\": [\"low\", \"medium\", \"high\"]`); `\"*\"` applies to all models labelled `reasoning`. An empty array hides the picker for matching models."
				}
			}
		},
		"commands": [
			{
				"command": "lemonade.manage",
				"title": "Manage Lemonade Provider"
			},
			{
				"command": "lemonade.toggleEphemeralFilter",
				"title": "Toggle Lemonade filter ephemeral data"
			}
		]
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"download-api": "dts dev",
		"postdownload-api": "dts main",
		"postinstall": "npm run download-api",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"format": "prettier --write .",
		"watch": "tsc -watch -p ./",
		"test": "pnpm run compile && vscode-test"
	},
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^22",
		"@types/mocha": "^10.0.6",
		"@vscode/dts": "^0.4.1",
		"@types/vscode": "^1.103.0",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^9.13.0",
		"prettier": "^3.1.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	},
	"packageManager": "pnpm@8.15.4+sha512.0bd3a9be9eb0e9a692676deec00a303ba218ba279d99241475616b398dbaeedd11146f92c2843458f557b1d127e09d4c171e105bdcd6b61002b39685a8016b9e"
}
